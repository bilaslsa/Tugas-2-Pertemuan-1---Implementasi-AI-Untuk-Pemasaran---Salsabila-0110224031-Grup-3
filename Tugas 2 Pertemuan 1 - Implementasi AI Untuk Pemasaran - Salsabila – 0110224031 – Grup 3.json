    {
      "parameters": {
        "jsCode": "// Batas maksimal polling agar tidak infinite loop\nconst maxAttempt = 30;\n\n// $runIndex = berapa kali node ini sudah berjalan (mulai dari 0)\nconst attempt = $runIndex + 1;\n\nif (attempt >= maxAttempt) {\n  throw new Error(`Batas polling tercapai (${maxAttempt}x). Gambar belum selesai, coba lagi nanti.`);\n}\n\n// Lanjutkan loop\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        368
      ],
      "id": "3586de83-54df-4952-aae2-c67fd1ae600f",
      "name": "Batas Percobaan"
    },
    {
      "parameters": {
        "jsCode": "// 1. Ambil data dari node Cek Status (lewat IF)\nconst data = $input.first().json.data;\nif (!data) {\n  throw new Error('Respons tidak memiliki field \"data\". Cek struktur respons API.');\n}\n\n// 2. resultJson biasanya berupa STRING JSON -> ubah jadi objek\nlet result = data.resultJson;\nif (typeof result === 'string') {\n  try {\n    result = JSON.parse(result);\n  } catch (e) {\n    throw new Error('Gagal membaca resultJson: ' + e.message);\n  }\n}\n\n// 3. Ambil array URL hasil [SESUAIKAN nama field: resultUrls]\nconst urls = result && Array.isArray(result.resultUrls) ? result.resultUrls : [];\n\n// 4. Filter hanya URL valid (diawali http:// atau https://)\nconst validUrls = urls.filter(\n  (u) => typeof u === 'string' && (u.startsWith('http://') || u.startsWith('https://'))\n);\n\n// 5. Error jelas jika tidak ada URL valid\nif (validUrls.length === 0) {\n  throw new Error('Tidak ada URL gambar valid pada hasil. Isi resultUrls: ' + JSON.stringify(urls));\n}\n\n// 6. Kembalikan URL pertama (plus semua URL & prompt untuk caption)\nreturn [{\n  json: {\n    imageUrl: validUrls[0],\n    allUrls: validUrls,\n    prompt: $('Simpan taskId').first().json.prompt\n  }\n}];"
      },
